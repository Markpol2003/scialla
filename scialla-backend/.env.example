PORT=10000
NODE_ENV=production
DATABASE_URL=postgres://user:password@hostname:5432/scialla
FRONTEND_URL=https://scialla.onrender.com
JWT_SECRET=scialla_super_secret_jwt_key_2026

# Initial Store Manager Provisioning (seeded once on fresh database setup)
INITIAL_MANAGER_EMAIL=manager@scialla.com
INITIAL_MANAGER_PASSWORD=your_secure_manager_password
INITIAL_MANAGER_FIRST_NAME=Store
INITIAL_MANAGER_LAST_NAME=Manager

# Email / Nodemailer Gmail Configuration (used for password reset verification codes)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_digit_google_app_password
EMAIL_FROM=Scialla Cafe <your_email@gmail.com>
# Or custom SMTP host:
# EMAIL_HOST=smtp.example.com
